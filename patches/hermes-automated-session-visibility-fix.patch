@@ -5,6 +5,70 @@ from __future__ import annotations
 from typing import Any
 
 
+# These sources are generated by Hermes itself rather than by a human-facing
+# conversation. Keep them in the canonical store, but omit them from default
+# human recents/history views.
+AUTOMATED_SESSION_SOURCES = frozenset({"cron", "kanban", "tool"})
+_DISPLAY_STATUS_PREFIXES = ("[automated]", "[open]", "[closed]")
+
+
+def strip_display_status_prefixes(title: str) -> tuple[str, bool]:
+    """Strip generated status labels and report an explicit closed marker."""
+    value = str(title or "").strip()
+    explicitly_closed = False
+    while True:
+        lowered = value.lower()
+        matched = next(
+            (
+                prefix
+                for prefix in _DISPLAY_STATUS_PREFIXES
+                if lowered == prefix or lowered.startswith(prefix + " ")
+            ),
+            None,
+        )
+        if matched is None:
+            break
+        explicitly_closed = explicitly_closed or matched == "[closed]"
+        value = value[len(matched):].lstrip()
+    return value, explicitly_closed
+
+
+def is_automated_session(row: dict[str, Any]) -> bool:
+    """Return whether a session row was generated by an automated source."""
+    return str(row.get("source") or "").strip().lower() in AUTOMATED_SESSION_SOURCES
+
+
+def is_closed_session(row: dict[str, Any]) -> bool:
+    """Return whether a session has reached a terminal lifecycle state."""
+    _, explicitly_closed = strip_display_status_prefixes(row.get("title") or "")
+    return explicitly_closed or bool(row.get("ended_at") or row.get("end_reason"))
+
+
+def display_session_title(row: dict[str, Any]) -> str:
+    """Return a non-persistent title with lifecycle/source labels.
+
+    Stored user titles are never changed. Existing generated status prefixes are
+    stripped before rebuilding the label so repeated listing never duplicates
+    ``[automated]``, ``[open]``, or ``[closed]``.
+    """
+    title, _ = strip_display_status_prefixes(row.get("title") or "")
+    labels = []
+    if is_automated_session(row):
+        labels.append("[automated]")
+    labels.append("[closed]" if is_closed_session(row) else "[open]")
+    return " ".join(labels + [title or "Untitled session"])
+
+
+def prepare_session_rows(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Add display-only lifecycle/source titles without mutating database rows."""
+    prepared = []
+    for row in rows:
+        copy = dict(row)
+        copy["title"] = display_session_title(copy)
+        prepared.append(copy)
+    return prepared
+
+
